#!/usr/bin/env bash
# VibeKernel local env — TEMPLATE (this .example file IS committed; env.sh is NOT).
#
# Setup:
#     cp env.sh.example env.sh        # then edit env.sh to point at YOUR free GPU
#
# The launcher (scripts/_run_common.sh) sources env.sh if present, else falls
# back to this template. It pins every build/run/profile to one GPU so a run
# never lands on a busy card. Change the index to whichever GPU is free on your box.
#
export CUDA_VISIBLE_DEVICES=0
