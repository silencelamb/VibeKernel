+    for (int i = 0; i < WTILES_M; i++)
+#pragma unroll
+        for (int j = 0; j < WTILES_N; j++)
+#pragma unroll
+            for (int t = 0; t < 4; t++)
+                acc[i][j][t] = 0.0f;
