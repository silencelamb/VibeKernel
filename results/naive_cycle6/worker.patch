+                              b_frag[buf][g * 2 + 0][0],
+                              b_frag[buf][g * 2 + 0][1],
+                              b_frag[buf][g * 2 + 1][0],
+                              b_frag[buf][g * 2 + 1][1]);
+        }
+    };
