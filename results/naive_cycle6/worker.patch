+__global__ void __launch_bounds__(NUM_THREADS)
+kernel_v5(int M, int N, int K, const half* __restrict__ A,
+          const half* __restrict__ B, half* __restrict__ C)
+{
+    extern __shared__ half smem[];
+    half* sA = smem;
+    half* sB = smem + NSTAGE * STAGE_A;
