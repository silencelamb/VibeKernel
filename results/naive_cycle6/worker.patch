+            cp_async_cg16(smem_u32(&dA[swz(row, col8, BK)]), gptr);
+        }
+#pragma unroll
+        for (int i = 0; i < (BK * BN / 8) / NUM_THREADS; i++) {
+            int vec = tid + i * NUM_THREADS;
+            int row = vec / (BN / 8);
+            int col8 = (vec % (BN / 8)) * 8;
+            const half* gptr = B + (kk + row) * N + (blockCol * BN + col8);
+            cp_async_cg16(smem_u32(&dB[swz(row, col8, BN)]), gptr);
+        }
+    };
+
