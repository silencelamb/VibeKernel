diff --git a/scripts/bench.sh b/scripts/bench.sh
new file mode 100644
index 0000000..8f3a238
--- /dev/null
+++ b/scripts/bench.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# bench.sh N [BUILD_TAG] — build version N in an isolated build dir and benchmark
+# under a global GPU lock (single bound GPU; concurrent kernels time-slice and
+# corrupt sustained timing). Prints one parseable line:
+#   V<N> RESULT TFLOPS=<x|BUILD_FAIL|RUN_FAIL> ERR=<y|NA>
+# Uses the task's own 100-round-average scoring (the only legal score).
+set -uo pipefail
+cd "$(dirname "$0")/.."   # repo root, so callers can run from anywhere
+N="$1"
+TAG="${2:-$N}"
+BD="build_v${TAG}"
+LOG="/tmp/build_v${TAG}.log"
+
+if ! bash scripts/build-task1.sh -f16 "-v${N}" -B "./${BD}" > "$LOG" 2>&1; then
+  echo "V${N} RESULT TFLOPS=BUILD_FAIL ERR=NA"
+  grep -E "error:|Error|FATAL|fatal" "$LOG" | head -8
+  exit 1
+fi
+
+BIN="./${BD}/src/task1_float16_v${N}"
+OUT=$(flock /tmp/vibekernel_gpu.lock "$BIN" -m 4096 -n 4096 -k 4096 -t 100 2>&1)
+T=$(echo "$OUT" | grep -oE "TFLOPS: [0-9.]+" | grep -oE "[0-9.]+" | head -1)
+E=$(echo "$OUT" | grep -oE "Average Error: [0-9.eE+-]+" | grep -oE "[0-9.eE+-]+$" | head -1)
+if [ -z "$T" ]; then
+  echo "V${N} RESULT TFLOPS=RUN_FAIL ERR=NA"
+  echo "$OUT" | tail -6
+  exit 1
+fi
+echo "V${N} RESULT TFLOPS=${T} ERR=${E}"
