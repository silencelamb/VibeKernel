+__global__ __launch_bounds__(NUM_THREADS) void kernel(
+    int M, int N, int K, const half* __restrict__ A, const half* __restrict__ B,
+    half* __restrict__ C)
+{
+    extern __shared__ half smem[];
+    half* As = smem;
