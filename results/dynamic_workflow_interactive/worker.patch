+// @file: task-1/src/matmul_f16/matmul_f16_v11_split.cu
+//
+// v12: v11 + threadblock swizzle (group CTAs into super-tiles for L2 reuse).
+//      sweeps) + split global prefetch.
+//   Block 256x128, BK=64, 8 warps (4x2) -> warp tile 64x64.
+//   mma.m16n8k16.f32 (fp32 accum, stable ~3e-5 error), ldmatrix.x4 / x4.trans,
+//   3-stage cp.async pipeline, interleaved inner-K mainloop (ldmatrix(ki+1)
+//   overlaps mma(ki)), padded conflict-free smem.
+//   NEW: the next tile's cp.async prefetch is spread across the K16 inner
+//   steps (instead of one burst) to reduce LSU/lg_throttle pressure.
+
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include "playground/matmul.hpp"
+
+namespace playground
+{
+namespace
+{
