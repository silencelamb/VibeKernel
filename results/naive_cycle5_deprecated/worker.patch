+        int cur = kt % STAGES;
+        half* Asb = As + cur * AS;
+        half* Bsb = Bs + cur * BS;
+
+        // Register double-buffered fragments: prefetch next k-step's
+        // ldmatrix while computing current k-step's mma (hides smem latency).
+        uint32_t aReg[2][MFRAG][4];
+        uint32_t bReg[2][NFRAG][2];
