+            int nCol = blockCol + warpCol + ni * 8 + tidg * 2;
+            half2 r01 = __floats2half2_rn(acc[mi][ni][0], acc[mi][ni][1]);
+            half2 r23 = __floats2half2_rn(acc[mi][ni][2], acc[mi][ni][3]);
