+    if (!configured) {
+        cudaFuncSetAttribute(v15::gemm, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                             smemBytes);
+        configured = true;
+    }
+    dim3 block(v15::N_THREADS);
+    dim3 grid(n / v15::BN, m / v15::BM);
+    v15::gemm<<<grid, block, smemBytes>>>(A, B, C, int(m), int(n), int(k));
+}
