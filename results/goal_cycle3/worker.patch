+                __floats2half2_rn(acc[mi][nj][2], acc[mi][nj][3]);
+        }
+    }
+    __syncwarp();
+    // Each lane writes 2 cols (one float) per row -> 32 lanes = 128B/row coalesced.
+#pragma unroll
